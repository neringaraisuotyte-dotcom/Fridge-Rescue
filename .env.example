# Supabase project settings (required for accounts and saved recipes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter (required for AI recipe adaptation; keep this server-side)
OPENROUTER_API_KEY=
# Optional. Defaults to openrouter/auto.
OPENROUTER_MODEL=

# Optional. Used as OpenRouter HTTP-Referer metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
